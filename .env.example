# Create a "script" app at https://www.reddit.com/prefs/apps and copy the values.
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_reddit_username
# Optional: only needed for the "password" grant. Leave blank to use
# app-only (client_credentials) auth, which is enough for reading public data.
REDDIT_PASSWORD=

# SocialCrawl (https://www.socialcrawl.dev) — used by scripts/socialcrawl_scraper.py
SOCIALCRAWL_API_KEY=sc_your_key
